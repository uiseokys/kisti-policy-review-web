VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_BASE_PATH=/
# GitHub Pages workflow sets /<repository-name>/ at build time.
# Real-data cloud synchronization is deliberately unavailable in this release.
# Never put secret or service_role keys in a VITE_* variable.

# Local bootstrap only: set these to four distinct existing Supabase Auth user UUIDs
# in .env.local or the shell before running node scripts/prepare-supabase.mjs.
# These values are not sent to the browser; do not add passwords here.
KISTI_REVIEWER_1_ID=
KISTI_REVIEWER_2_ID=
KISTI_REVIEWER_3_ID=
KISTI_ADMIN_ID=

